# Единые концы строк: в репозитории всегда LF, чтобы правки из разных
# инструментов (Windows/Linux, IDE, ИИ-агенты) не переписывали целые файлы.
* text=auto

# Linux-скрипты и systemd-юниты обязаны сохранять LF и в рабочей копии:
# они копируются на ВМ как есть (см. deploy/).
*.sh text eol=lf
deploy/chemsource-idle-shutdown text eol=lf
deploy/*.service text eol=lf
deploy/*.timer text eol=lf
deploy/*.example text eol=lf
deploy/daemon.json text eol=lf

# Windows-скрипты выполняются cmd/PowerShell и сохраняют CRLF.
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf

# Бинарные артефакты не трогаем.
*.docx binary
*.png binary
*.jpg binary
*.ico binary
*.db binary
