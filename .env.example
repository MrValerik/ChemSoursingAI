# ===== ChemSource AI — пример конфигурации =====
# Скопируйте в .env и заполните. Файл .env в git не коммитится.

# --- Приложение ---
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
# Внешний порт сайта в Docker Compose. Для ВМ используйте стандартный HTTP-порт.
WEB_PORT=80

# --- База данных (PostgreSQL + pgvector) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=chemsource
POSTGRES_USER=chemsource
POSTGRES_PASSWORD=change_me
# Полный DSN (если задан, перекрывает поля выше)
# DATABASE_URL=postgresql+psycopg://chemsource:change_me@localhost:5432/chemsource

# --- Аутентификация (JWT) ---
AUTH_SECRET_KEY=dev-secret-change-in-prod
ACCESS_TOKEN_EXPIRE_MINUTES=480
# Отдельный случайный ключ для шифрования паролей и токенов, сохранённых через UI.
# Если пуст, backend использует AUTH_SECRET_KEY. В production обязательно задайте.
INTEGRATION_ENCRYPTION_KEY=

# --- Очередь / брокер ---
REDIS_URL=redis://localhost:6379/0

# --- LLM (llama-server на хосте ВМ, backend запускается в Docker) ---
# host.docker.internal добавлен в docker-compose.yml через host-gateway.
LLM_BASE_URL=http://host.docker.internal:8000/v1
LLM_MODEL=Qwen_Qwen3.5-27B-Q4_K_M
LLM_API_KEY=not-needed-for-local
# Qwen 27B с CPU/GPU offloading отвечает медленнее полностью GPU-резидентной модели.
LLM_TIMEOUT_S=600
# Размер контекста llama-server (--ctx-size). Backend сам ужимает
# передаваемые страницы под этот бюджет.
LLM_CONTEXT_TOKENS=12288

# --- Бюджеты одного этапа поиска поставщиков ---
# Исчерпание бюджета завершает этап безопасным частичным результатом со stop reason в трассе.
SEARCH_MAX_QUERIES=12
SEARCH_MAX_PAGE_FETCHES=30
SEARCH_MAX_LLM_CALLS=40
SEARCH_MAX_RUNTIME_S=2700

# --- PubChem (бесплатный, без ключа) ---
PUBCHEM_BASE_URL=https://pubchem.ncbi.nlm.nih.gov/rest/pug

# --- Email-коннектор (IMAP/SMTP) ---
# demo — безопасная имитация; live — реальная SMTP-отправка.
EMAIL_DELIVERY_MODE=demo
EMAIL_FROM=
EMAIL_FROM_NAME=ChemSource AI
EMAIL_TIMEOUT_S=30
# off — не создавать дозапрос; draft — черновик; send — отправить автоматически.
AUTO_FOLLOWUP_MODE=draft
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_USE_SSL=true
IMAP_FOLDER=INBOX
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_SSL=true
SMTP_STARTTLS=false

# --- WhatsApp Cloud API — заполняется на этапе интеграций ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_API_BASE_URL=https://graph.facebook.com
WHATSAPP_API_VERSION=v23.0
WHATSAPP_TIMEOUT_S=30
