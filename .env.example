# ===== ChemSource AI — пример конфигурации =====
# Скопируйте в .env и заполните. Файл .env в git не коммитится.

# --- Приложение ---
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
# Создаёт готовый синтетический RFQ с переписками и котировками. Не включайте
# на рабочем контуре, если демонстрационные данные там не нужны.
DEMO_WORKSPACE_ENABLED=false
# Внешний порт сайта в Docker Compose. Для ВМ используйте стандартный HTTP-порт.
WEB_PORT=80

# --- База данных (PostgreSQL + pgvector) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=chemsource
POSTGRES_USER=chemsource
POSTGRES_PASSWORD=change_me
# Полный DSN (если задан, перекрывает поля выше)
# DATABASE_URL=postgresql+psycopg://chemsource:change_me@localhost:5432/chemsource

# --- Аутентификация (JWT) ---
AUTH_SECRET_KEY=dev-secret-change-in-prod
ACCESS_TOKEN_EXPIRE_MINUTES=480
# Отдельный случайный ключ для шифрования паролей и токенов, сохранённых через UI.
# Если пуст, backend использует AUTH_SECRET_KEY. В production обязательно задайте.
INTEGRATION_ENCRYPTION_KEY=

# --- Очередь / брокер ---
REDIS_URL=redis://localhost:6379/0

# --- LLM (llama-server на хосте ВМ, backend запускается в Docker) ---
# host.docker.internal добавлен в docker-compose.yml через host-gateway.
LLM_BASE_URL=http://host.docker.internal:8000/v1
LLM_MODEL=Qwen_Qwen3.5-27B-Q4_K_M
LLM_API_KEY=not-needed-for-local
# bearer | api-key; для Yandex AI Studio используется api-key.
LLM_AUTH_SCHEME=bearer
# Идентификатор каталога для заголовка OpenAI-Project; локально пустой.
LLM_PROJECT_ID=
# Чем выключить режим рассуждения: chat_template_kwargs | reasoning_effort | none.
# Без выключателя рассуждающая модель тратит весь лимит выхода на размышление
# и возвращает пустой ответ. На Yandex Qwen3.6 работают оба первых варианта.
LLM_THINKING_CONTROL=chat_template_kwargs
# Qwen 27B с CPU/GPU offloading отвечает медленнее полностью GPU-резидентной модели.
LLM_TIMEOUT_S=600
# Размер контекста llama-server (--ctx-size). Backend сам ужимает
# передаваемые страницы под этот бюджет.
LLM_CONTEXT_TOKENS=12288
# Сколько токенов отводится ответу. Делит контекст с текстом страниц,
# поэтому подняв его, бюджет страниц уменьшится автоматически. Облачная
# Qwen3.6 пишет длиннее локальной: в 1536 её ответ по крупному пакету
# оценки не помещался и обрывался на полуслове.
LLM_MAX_OUTPUT_TOKENS=1536

# --- Выделенная облачная LLM для «Тестирования общения» ---
# Если три обязательных поля ниже пусты, локальная разработка использует
# основной LLM-профиль. В production заполните их отдельно, чтобы песочница
# не зависела от модели поиска. Настоящий API-ключ храните только в .env.
COMMUNICATION_TEST_LLM_BASE_URL=
COMMUNICATION_TEST_LLM_MODEL=
COMMUNICATION_TEST_LLM_API_KEY=
COMMUNICATION_TEST_LLM_AUTH_SCHEME=api-key
COMMUNICATION_TEST_LLM_PROJECT_ID=
COMMUNICATION_TEST_LLM_THINKING_CONTROL=chat_template_kwargs
COMMUNICATION_TEST_LLM_TIMEOUT_S=600
# Стоимость миллиона входных/выходных токенов для прозрачного лимита диалога.
# Укажите тариф фактического LLM-провайдера; 0 отключает накопление стоимости.
COMMUNICATION_LLM_INPUT_COST_PER_MILLION_USD=0
COMMUNICATION_LLM_OUTPUT_COST_PER_MILLION_USD=0
COMMUNICATION_COST_USD_RUB_RATE=100
# Пример production-профиля:
# COMMUNICATION_TEST_LLM_BASE_URL=https://llm.api.cloud.yandex.net/v1
# COMMUNICATION_TEST_LLM_MODEL=gpt://<folder_ID>/qwen3.6-35b-a3b/latest

# --- Документы поставщиков (CoA/TDS/паспорт качества) ---
# Файлы остаются в контуре заказчика; каталог монтируется как том Docker.
ATTACHMENT_STORAGE_DIR=/app/data/attachments
ATTACHMENT_MAX_SIZE_MB=25
# OCR сканов работает на CPU и заметно медленнее чтения текстового слоя.
OCR_ENABLED=true
OCR_LANGUAGES=rus+eng
OCR_MAX_PAGES=5

# --- Бюджеты одного этапа поиска поставщиков ---
# Исчерпание бюджета завершает этап безопасным частичным результатом со stop reason в трассе.
SEARCH_MAX_QUERIES=12
SEARCH_MAX_PAGE_FETCHES=30
SEARCH_MAX_LLM_CALLS=40
SEARCH_MAX_RUNTIME_S=2700
SUPPLIER_INDUSTRIAL_PACKAGE_MIN_MASS_KG=20
SUPPLIER_INDUSTRIAL_PACKAGE_MIN_VOLUME_L=20

# --- Источник поисковой выдачи ---
# duckduckgo_html работает без ключа, но не имеет квоты и SLA: под нагрузкой
# отдаёт антибот-страницу вместо результатов. Для промышленной работы
# переключается на поисковый API с квотой.
# duckduckgo_html — без ключа, но без квоты и SLA; serper — выдача Google
# через API с квотой (2500 запросов бесплатно, дальше около $1 за тысячу).
SEARCH_PROVIDER=duckduckgo_html
# Ключ Serper. Секрет: держите только в .env, в репозиторий не коммитьте.
SERPER_API_KEY=
SERPER_REGION=cn
SERPER_LANGUAGE=en

# --- Аренда задач очереди поиска ---
# Пока аренда жива, задача принадлежит одному worker и другие процессы её не
# трогают. Worker продлевает аренду heartbeat-ом, поэтому TTL должен с запасом
# перекрывать интервал продления. После падения процесса задача возвращается в
# работу не позже, чем через SEARCH_LEASE_TTL_S.
SEARCH_LEASE_TTL_S=120
SEARCH_LEASE_HEARTBEAT_S=30

# --- PubChem (бесплатный, без ключа) ---
PUBCHEM_BASE_URL=https://pubchem.ncbi.nlm.nih.gov/rest/pug

# --- Email-коннектор (IMAP/SMTP) ---
# demo — безопасная имитация; live — реальная SMTP-отправка.
EMAIL_DELIVERY_MODE=demo
EMAIL_FROM=
EMAIL_FROM_NAME=ChemSource AI
EMAIL_TIMEOUT_S=30
# Получатель внутренних уведомлений из раздела «Обратная связь».
FEEDBACK_EMAIL_TO=
# off — не создавать дозапрос; draft — черновик; send — отправить автоматически.
AUTO_FOLLOWUP_MODE=draft
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_USE_SSL=true
IMAP_FOLDER=INBOX
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_SSL=true
SMTP_STARTTLS=false
# Автоответы только для реальных диалогов из «Тестирования общения».
# Worker выключен по умолчанию; включайте после проверки SMTP/IMAP и модели.
COMMUNICATION_TEST_EMAIL_AUTO_REPLY_ENABLED=false
COMMUNICATION_TEST_EMAIL_POLL_INTERVAL_S=30
COMMUNICATION_TEST_EMAIL_POLL_BATCH_SIZE=20

# --- WhatsApp: официальный Cloud API или неофициальный Web gateway ---
# cloud_api | web. Web-вариант может нарушать правила WhatsApp и привести к блокировке номера.
WHATSAPP_TRANSPORT=cloud_api
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_API_BASE_URL=https://graph.facebook.com
WHATSAPP_API_VERSION=v23.0
WHATSAPP_TIMEOUT_S=30
# Случайная длинная строка (минимум 32 байта), одинаковая для backend и gateway.
# Хранится только в production .env, через сайт не передаётся и в Git не коммитится.
WHATSAPP_WEB_SERVICE_TOKEN=
WHATSAPP_WEB_BASE_URL=http://whatsapp-web:3000
WHATSAPP_WEB_CALLBACK_TIMEOUT_MS=15000
WHATSAPP_WEB_MAX_MEDIA_MB=25
# Необязательный изолированный выход WhatsApp Web через Xray/VLESS.
# Сам VLESS-конфиг хранится только в игнорируемом data/xray/config.json.
# Чтобы включить профиль, задайте все три значения в production .env.
COMPOSE_PROFILES=
WHATSAPP_XRAY_CONFIG_PATH=./data/xray/config.json
WHATSAPP_WEB_PROXY_SERVER=
WHATSAPP_WEB_INIT_RETRY_MS=15000
