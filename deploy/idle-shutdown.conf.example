# Shut down after 30 minutes without a completed request to nginx.
IDLE_TIMEOUT_SECONDS=1800

# Never shut down during the first 30 minutes after VM boot.
MIN_UPTIME_SECONDS=1800

# Generated by nginx and mounted from the frontend container.
ACTIVITY_LOG=__PROJECT_DIR__/data/nginx/chemsource_access.log

# Connections on these ports count as active work. Port 443 is ready for HTTPS.
HTTP_PORTS="80 443"

# Set to 1 to test decisions without actually powering off the VM.
DRY_RUN=0
