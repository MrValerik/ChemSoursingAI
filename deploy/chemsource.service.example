[Unit]
Description=ChemSource AI Docker Compose stack
Requires=docker.service
Wants=network-online.target qwen.service
After=docker.service network-online.target qwen.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=__PROJECT_DIR__
# Images are built during deployment, not on every VM boot.
ExecStart=__DOCKER_BIN__ compose up -d
# Gracefully stop containers and PostgreSQL during a normal shutdown.
ExecStop=__DOCKER_BIN__ compose stop
TimeoutStartSec=0
TimeoutStopSec=90
# One container stumbling on a cold boot used to leave the whole site dark:
# compose aborts the run, the frontend never starts, and nothing retries.
# "compose up -d" is idempotent, so a second attempt costs nothing and
# brings up whatever is still missing.
Restart=on-failure
RestartSec=20

[Install]
WantedBy=multi-user.target
