# Создайте бота через @BotFather и не коммитьте реальный токен.
TELEGRAM_BOT_TOKEN=

# Только личные Telegram user_id через запятую. Пустой список запрещён.
TELEGRAM_ALLOWED_USER_IDS=

# Абсолютный путь к локальному checkout ChemSource AI.
TELEGRAM_PROJECT_ROOT=E:\MyProjects\TechLab\ChemSoursingAI

# Необязательные настройки.
TELEGRAM_POLL_TIMEOUT_SECONDS=30
TELEGRAM_MAX_IMAGE_MB=10
TELEGRAM_MAX_TEXT_FILE_KB=512
CODEX_MODEL=
